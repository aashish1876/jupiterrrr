# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JUPITERGENX CAREERS ADMIN AUTHORIZATION
# Comma-separated list of authorized administrator Google account email addresses.
# Only verified Google accounts listed here will be granted access to the Careers Admin Dashboard.
ADMIN_EMAILS="admin@example.com"

# GOOGLE OAUTH CLIENT ID (Google Cloud Console OAuth 2.0 Web Client ID)
# Used for Google Identity Services sign-in.
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

# SESSION SECRET
SESSION_SECRET="jupitergenx_enterprise_careers_secret_key"
